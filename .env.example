# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Must be "sandbox". Anything else and every PayPal call refuses to start (live PayPal is never used).
PAYPAL_ENV=sandbox

# Sandbox REST app credentials from developer.paypal.com > Apps & Credentials (Sandbox tab).
# Without them, probes and payment features fail at startup with a SandboxGuardError.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional. Only set it to https://api-m.sandbox.paypal.com; any other host is rejected by the sandbox guard.
PAYPAL_BASE_URL=

# Webhook ID of the sandbox app's webhook, used to verify incoming PayPal events.
# Without it, webhook verification fails and events are ignored (the app falls back to polling PayPal).
PAYPAL_WEBHOOK_ID=

# Anthropic API key for the AI features (change extraction, document reading, explanations).
# Without it, AI features are disabled and the studio enters changes by hand.
ANTHROPIC_API_KEY=

# Optional model override for change drafts; all model requests run on the server.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Postgres connection string. The default matches docker-compose.yml (start it with `npm run db:up`).
# Without it, the app cannot start; unit tests and probes do not need it.
DATABASE_URL=postgres://setti:setti@localhost:5433/setti

# Separate database for tests that need Postgres. Without it, those tests are skipped.
TEST_DATABASE_URL=postgres://setti:setti@localhost:5433/setti_test

# Optional. Database for `npm run sandbox:proof`; it is emptied on every run and must be named *_proof.
# Without it, the proof uses setti_proof on the DATABASE_URL server.
SETTI_PROOF_DATABASE_URL=postgres://setti:setti@localhost:5433/setti_proof

# Optional. A PayPal Sandbox personal (buyer) account, shown next to the PayPal window so whoever plays the client can log in.
# Never commit real values; set them on the server only.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Optional. Set to off to hide "Pay with the Sandbox test card" (on by default in this Sandbox-only demo).
SETTI_DEMO_TEST_CARD=
# New /try demo projects allowed per hour across all visitors (default 30).
SETTI_TRY_PER_HOUR=
