{
  "name": "setti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:examples": "vitest run --config vitest.examples.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe": "tsx",
    "sandbox:proof": "tsx probes/app-proof.ts",
    "holds:check": "tsx scripts/daily-check.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval:replay": "tsx --tsconfig tsconfig.json evals/change-draft/run.ts --backend replay --fresh && tsx --tsconfig tsconfig.json evals/money-answer/run.ts --backend replay --fresh && tsx --tsconfig tsconfig.json evals/inbox-summary/run.ts --backend replay --fresh",
    "eval:page": "tsx --tsconfig tsconfig.json evals/page-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
